.includes('merenda'))}
function mainPool(){return RICETTE.filter(r=>!r.tags.includes('colazione')&&!r.tags.includes('spuntino')&&!r.tags.includes('merenda')||r.tags.includes('pranzo')||r.tags.includes('cena'))}
function init(){if(typeof RICETTE==='undefined'||typeof st==='undefined')return setTimeout(init,80);const a=extra(),ids=new Set(RICETTE.map(r=>r.id));a.forEach(r=>{if(!ids.has(r.id))RICETTE.push(r)});document.title='App Alimentazione — Dalla Simo v1.9';const bs=document.querySelector('.brand-subtitle');if(bs)bs.textContent='Alimentazione familiare · v1.9';document.querySelectorAll('.brand-logo,.hero-logo').forEach(i=>i.src='./brand-v19-512.png?v=19');const css=document.createElement('style');css.textContent='.brand-logo{width:164px!important;height:120px!important;object-fit:contain!important;padding:0!important}.hero-logo{width:min(96vw,520px)!important;height:auto!important;max-height:none!important;object-fit:contain!important;padding:0!important;margin:0 auto 8px!important}.brand-home{padding:2px 0 8px!important}.meal-row{grid-template-columns:82px 1fr auto!important}.quick-ing{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.quick-ing button{border:1px solid var(--border);background:#fff;padding:8px 10px;border-radius:999px;font-size:12px}.quick-ing button.on{background:var(--green);color:#fff;border-color:var(--green)}.match-good{color:var(--green);font-weight:800}.match-miss{color:var(--amber)}';document.head.appendChild(css);
const rs=document.getElementById('ricette');if(rs){const sb=rs.querySelector('.sub');if(sb)sb.textContent='Archivio locale · '+RICETTE.length+' ricette';const q=document.getElementById('q');if(q&&!document.getElementById('btnRicettaRapida')){const d=document.createElement('div');d.className='grid2';d.style.margin='10px 0 2px';d.innerHTML='<button id="btnRicettaRapida" class="btn" onclick="apriRicettaRapidaV19()">⚡ Ricetta rapida</button><button class="btn secondary" onclick="resetRicerca()">Azzera ricerca</button>';q.insertAdjacentElement('afterend',d)}}const nav=[...document.querySelectorAll('.nav button')].find(b=>b.dataset.s==='settimana');if(nav)nav.innerHTML='<b>🍽️</b>Dieta';const sec=document.getElementById('settimana');if(sec){const sb=sec.querySelector('.sub'),h=sec.querySelector('h1');if(sb)sb.textContent='Colazione · Spuntino · Pranzo · Merenda · Cena';if(h)h.textContent='Dieta completa';const b=sec.querySelector('.grid2 .btn');if(b)b.textContent='Completa dieta'}
const def={Colazione:a.find(r=>r.nome==='Yogurt con banana')?.id,Spuntino:a.find(r=>r.nome==='Mela e mandorle')?.id,Merenda:a.find(r=>r.nome==='Frutta fresca con yogurt')?.id};['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'].forEach(g=>{st.settimana[g]=st.settimana[g]||{};PASTI.forEach(t=>{if(!(t in st.settimana[g]))st.settimana[g][t]=(t==='Pranzo'||t==='Cena')?null:def[t]})});if(typeof save==='function')save();
window.renderSettimana=function(){const G=['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'],gb=document.getElementById('giorniPlanner');if(!gb)return;gb.innerHTML=G.map(g=>'<button class="week-day '+(g===st.giornoPlanner?'on':'')+'" onclick="selezionaGiornoPlanner(\''+g+'\')">'+g.slice(0,3).toUpperCase()+'</button>').join('');const p=st.settimana[st.giornoPlanner]||{};document.getElementById('pianoGiorno').innerHTML='<div class="card">'+PASTI.map(t=>{const r=RICETTE.find(x=>x.id===p[t]);return '<div class="meal-row"><div class="tiny"><b>'+t+'</b></div><div><div class="recipe-title">'+(r?e(r.nome)+' · '+e(r.variante):'Non pianificato')+'</div><div class="meta">'+(r?r.minuti+' minuti':'Scegli o chiedi un suggerimento')+'</div></div><button class="btn small secondary" onclick="scegliPastoPlannerV19(\''+st.giornoPlanner+'\',\''+t+'\')">'+(r?'Cambia':'Scegli')+'</button></div>'}).join('')+'</div>'};
window.scegliPastoPlannerV19=function(g,t){const u=Object.values(st.settimana).flatMap(x=>Object.values(x||{})).filter(Boolean),arr=pool(t).map(r=>({r,s:65+(r.tags.includes('famiglia')?8:0)+(r.minuti<=20?6:0)+(r.tags.includes(t.toLowerCase())?18:0)-u.filter(x=>x===r.id).length*10+(typeof favByAny==='function'&&favByAny(r.id)?5:0)})).sort((a,b)=>b.s-a.s).slice(0,14);openModal('Scegli '+t.toLowerCase(),arr.map(x=>'<div class="family row between"><div><div class="recipe-title">'+e(x.r.nome)+' · '+e(x.r.variante)+'</div><div class="meta">'+x.r.minuti+' min · punteggio '+x.s+'</div></div><button class="btn small" onclick="salvaPastoPlannerV19(\''+g+'\',\''+t+'\',\''+x.r.id+'\')">Scegli</button></div>').join(''))};window.salvaPastoPlannerV19=(g,t,id)=>{st.settimana[g][t]=id;save();closeModal();renderSettimana();toast('Pasto aggiornato')};window.completaSettimana=function(){const G=['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'];G.forEach((g,gi)=>PASTI.forEach((t,ti)=>{if(!st.settimana[g][t]){const p=pool(t);if(p.length)st.settimana[g][t]=p[(gi+ti)%p.length].id}}));save();renderSettimana();toast('Dieta completa aggiornata')};
window.consiglioFamiglia=function(){const profiles=Object.fromEntries((st.profiliAlimentari||[]).map(p=>[p.member_id,p])),ctx={};st.membri.forEach(m=>ctx[m.id]={profile:profiles[m.id]||null,recentCategories:st.storicoCategorie||[],pantryNames:(st.dispensa||[]).map(x=>x.nome),sample:(st.registro||[]).length});return window.DallaSimoEngine.rankForFamily(mainPool(),st.membri,ctx)[0]||null};
window.renderConsigli=function(){const box=document.getElementById('consigliGiorno'),mp=mainPool();box.innerHTML=st.membri.map(m=>{const best=mp.map(r=>({r,s:scorePerMembro(r,m)})).sort((a,b)=>b.s-a.s)[0],motivo=m.tipo==='adulto'?'Consiglio provvisorio: finché non inserisci il profilo alimentare, considero varietà, praticità e preferenze.':(m.preferiti.includes(best.r.id)?'È tra i suoi preferiti, bilanciato con la varietà recente.':'Aumenta la varietà e resta adatto a un pasto familiare.');return '<div class="card hero"><div class="row between"><div class="member"><div class="avatar">'+e(m.nome[0])+'</div><div>