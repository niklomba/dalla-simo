<h3>'+e(m.nome)+'</h3><div class="meta">'+e(m.eta)+'</div></div></div><span class="pill">'+(m.tipo==='adulto'?'Adulto':'Ragazzo')+'</span></div><div class="row" style="margin-top:13px"><div class="icon">'+iconCat(best.r.categoria)+'</div><div style="flex:1"><div class="recipe-title">'+e(best.r.nome)+' · '+e(best.r.variante)+'</div><div class="meta">'+best.r.minuti+' minuti · punteggio '+best.s+'</div></div></div><p class="meta">'+motivo+'</p><button class="btn small soft" onclick="openRecipe(\''+best.r.id+'\')">Apri ricetta</button></div>'}).join('');const f=consiglioFamiglia();if(f){const x=window.DallaSimoEngine.explanation(f.recipe,f.memberResults[0]);box.innerHTML='<div class="card hero"><div class="row between"><div><h3>🍽️ Consiglio per tutta la famiglia</h3><div class="meta">Protegge anche il membro meno compatibile</div></div><span class="pill">'+f.score+'/100</span></div><div class="recipe-title" style="margin-top:12px">'+e(f.recipe.nome)+' · '+e(f.recipe.variante)+'</div><p class="meta">'+e(x)+'</p><button class="btn small soft" onclick="openRecipe(\''+f.recipe.id+'\')">Apri ricetta</button></div>'+box.innerHTML}};
if(typeof apriRegistraPasto==='function'){const old=apriRegistraPasto;window.apriRegistraPasto=function(){old();setTimeout(()=>{const s=document.getElementById('logTipo');if(s&&![...s.options].some(o=>o.value==='Merenda'))s.add(new Option('Merenda','Merenda'))},0)}}renderRicette();renderSettimana();renderConsigli()}
window.apriRicettaRapidaV19=function(){qset=new Set();const f={};RICETTE.forEach(r=>r.ingredienti.forEach(i=>{const k=n(i);f[k]=(f[k]||0)+1}));const c=Object.entries(f).sort((a,b)=>b[1]-a[1]).slice(0,70).map(x=>x[0]);openModal('⚡ Ricetta rapida','<div class="note">Seleziona gli ingredienti che hai. Mostro prima le ricette con meno ingredienti mancanti.</div><div class="row" style="margin-top:12px"><input id="rapidoNuovo" class="search" placeholder="Aggiungi ingrediente, es. uova"><button class="btn small" onclick="aggiungiQuickV19()">Aggiungi</button></div><div class="shop-actions"><button class="btn small soft" onclick="dispensaQuickV19()">Usa la dispensa ('+(st.dispensa||[]).length+')</button><button class="btn small secondary" onclick="baseQuickV19()">Olio/sale/pepe</button></div><h3 style="margin-top:15px">Ingredienti comuni</h3><div id="quickIng" class="quick-ing">'+c.map(i=>'<button data-quick="'+encodeURIComponent(i)+'" onclick="toggleQuickV19(this,\''+encodeURIComponent(i)+'\')">'+e(i)+'</button>').join('')+'</div><button class="btn full" style="margin-top:14px" onclick="trovaQuickV19()">Trova la ricetta migliore</button><div id="quickResults"></div>')};window.toggleQuickV19=(b,x)=>{const i=n(decodeURIComponent(x));qset.has(i)?qset.delete(i):qset.add(i);b.classList.toggle('on',qset.has(i))};window.aggiungiQuickV19=function(){const z=document.getElementById('rapidoNuovo'),i=n(z.value);if(!i)return;qset.add(i);z.value='';document.getElementById('quickIng').insertAdjacentHTML('afterbegin','<button class="on" data-quick="'+encodeURIComponent(i)+'" onclick="toggleQuickV19(this,\''+encodeURIComponent(i)+'\')">'+e(i)+'</button>')};window.dispensaQuickV19=function(){(st.dispensa||[]).forEach(x=>qset.add(n(x.nome)));document.querySelectorAll('[data-quick]').forEach(b=>b.classList.toggle('on',qset.has(n(decodeURIComponent(b.dataset.quick)))));toast('Ingredienti della dispensa selezionati')};window.baseQuickV19=function(){['olio','sale','pepe'].forEach(i=>qset.add(i));document.querySelectorAll('[data-quick]').forEach(b=>b.classList.toggle('on',qset.has(n(decodeURIComponent(b.dataset.quick)))))};window.trovaQuickV19=function(){const b=document.getElementById('quickResults');if(!qset.size){b.innerHTML='<div class="note">Seleziona almeno un ingrediente.</div>';return}const base=new Set(['sale','pepe','olio','acqua']),a=RICETTE.map(r=>{const u=[...new Set(r.ingredienti.map(n))].filter(i=>!base.has(i)),m=u.filter(i=>qset.has(i)),miss=u.filter(i=>!qset.has(i)),c=u.length?m.length/u.length:0;return{r,m,miss,c}}).filter(x=>x.m.length).sort((a,b)=>a.miss.length-b.miss.length||b.c-a.c||a.r.minuti-b.r.minuti).slice(0,12);b.innerHTML=a.length?'<h3 style="margin-top:16px">Consigli migliori</h3>'+a.map((x,i)=>'<div class="card '+(i===0?'hero':'')+'"><div class="row between"><div><div class="recipe-title">'+(i===0?'⭐ ':'')+e(x.r.nome)+' · '+e(x.r.variante)+'</div><div class="meta">'+x.r.minuti+' min · <span class="match-good">hai '+x.m.length+'/'+(x.m.length+x.miss.length)+'</span></div></div><button class="btn small" onclick="openRecipe(\''+x.r.id+'\')">Apri</button></div>'+(x.miss.length?'<div class="meta match-miss">Mancano: '+e(x.miss.slice(0,5).join(', '))+'</div>':'<div class="meta match-good">Hai tutto il necessario principale.</div>')+'</div>').join(''):'<div class="note">Nessuna ricetta compatibile.</div>'};if(document.readyState==='complete')init();else window.addEventListener('load',init)})();
